# Public site URL
NEXT_PUBLIC_SITE_URL=https://about.esbgames.com

# Shared ESB Games Production Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy Supabase variable names are also supported, but do not leave empty
# duplicates in Vercel. Use one complete set of variable names.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Resend support email delivery
# Verify the exact sending domain in Resend before testing. A dedicated sending
# subdomain such as mail.esbgames.com is recommended.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=ESB Games Support <support@mail.esbgames.com>
SUPPORT_REPLY_TO_EMAIL=support@esbgames.com

# Newsletter confirmation / unsubscribe emails
NEWSLETTER_FROM_EMAIL=ESB Games <updates@esbgames.com>
NEWSLETTER_REPLY_TO_EMAIL=contact@esbgames.com

# Careers email delivery
CAREERS_FROM_EMAIL=ESB Games Careers <careers@mail.esbgames.com>
CAREERS_REPLY_TO_EMAIL=careers@esbgames.com

# Storage buckets created by the supplied SQL migrations
SUPPORT_EVIDENCE_BUCKET=support-ticket-evidence
RECRUITMENT_STORAGE_BUCKET=recruitment-candidate-files

# Secure Backend publishing revalidation webhook secret
REVALIDATION_SECRET=

# Keep preview flags false in Production
NEXT_PUBLIC_CONTENT_PREVIEW=false
NEXT_PUBLIC_CAREERS_PREVIEW=false
