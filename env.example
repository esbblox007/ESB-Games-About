# Public site URL
NEXT_PUBLIC_SITE_URL=https://about.esbgames.com

# Shared ESB Games Production Supabase project
# The About Vercel project needs its own environment variables even when the
# SQL migrations have already been run in the shared Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Public browser key. Set either the anon-key name or the newer publishable-key name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key. Set ONE of these names; SUPABASE_SECRET_KEY matches
# the wider ESB Games Backend convention. Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Resend email delivery. Verify the esbgames.com sending domain before production.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=ESB Games Support <support@esbgames.com>
SUPPORT_REPLY_TO_EMAIL=support@esbgames.com
CAREERS_FROM_EMAIL=ESB Games Careers <careers@esbgames.com>
CAREERS_REPLY_TO_EMAIL=careers@esbgames.com

# Shared private/public storage buckets created by the supplied SQL migrations.
SUPPORT_EVIDENCE_BUCKET=support-ticket-evidence
RECRUITMENT_STORAGE_BUCKET=recruitment-candidate-files

# Secure Backend publishing revalidation webhook secret
REVALIDATION_SECRET=

# Optional local article-renderer preview. Keep false in production unless the
# clearly labelled preview articles are intentionally being reviewed.
NEXT_PUBLIC_CONTENT_PREVIEW=false

# Optional local static Careers preview. Keep false in production.
NEXT_PUBLIC_CAREERS_PREVIEW=false
